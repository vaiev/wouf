#!/usr/bin/env python3
"""secret: keep keys out of the repository, the chat and the model's context.

  secret set NAME            store a value; asks with hidden input, only in your own terminal
  secret has NAME            exit 0 if NAME is stored
  secret list                stored names (never values)
  secret rm NAME             remove NAME; only in your own terminal
  secret run NAME[,NAME] -- command [args]
                             run command with NAME in its environment; the value is masked in its output

There is no "get": agents use a secret, they never see it.

Backend (WOUF_SECRET_BACKEND): keychain (macOS), secret-tool (Linux Secret Service), pass (entries
<WOUF_PASS_PREFIX>/NAME, default prefix wouf; only the first line is the value), file (WOUF_SECRET_DIR,
default ~/.config/wouf/secrets, mode 0700/0600, refused inside a git repository).
Default: keychain or secret-tool when available, else file; pass only when chosen.
"""

from __future__ import annotations

import getpass
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path

NAME = re.compile(r"^[A-Z][A-Z0-9_]{0,63}$")
SERVICE = "wouf"
MASK = "***"
PASS_TIMEOUT = 5  # seconds a locked pass store gets before its passphrase prompt is given up
PASS_LOCKED = "the pass store is locked or not answering"
PASS_BROKEN: list[str] = []  # set by the first failed read: this process reads nothing more from pass


class StoreLocked(Exception):
    """A stored value cannot be read now. The message names the store only, never a value or a key."""


def die(message: str, code: int = 2) -> None:
    print(f"secret: {message}", file=sys.stderr)
    raise SystemExit(code)


def check_name(name: str) -> str:
    if not NAME.match(name):
        die(f"invalid name {name!r}: use UPPER_CASE letters, digits and _")
    return name


def require_terminal(action: str) -> None:
    if not (sys.stdin.isatty() and sys.stderr.isatty()):
        die(f"'{action}' needs a person: run it in your own terminal, not through an agent")


def store_dir() -> Path:
    base = os.environ.get("WOUF_SECRET_DIR") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "wouf", "secrets")
    path = Path(base).expanduser().resolve()
    probe = path
    while not probe.exists():
        probe = probe.parent
    inside = subprocess.run(["git", "-C", str(probe), "rev-parse", "--is-inside-work-tree"],
                            capture_output=True, text=True) if shutil.which("git") else None
    if inside and inside.returncode == 0 and inside.stdout.strip() == "true":
        die(f"refusing a secret store inside a git repository: {path}")
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def backend() -> str:
    chosen = os.environ.get("WOUF_SECRET_BACKEND", "")
    if chosen:
        if chosen not in ("keychain", "secret-tool", "pass", "file"):
            die(f"unknown backend {chosen!r}")
        return chosen
    if sys.platform == "darwin" and shutil.which("security"):
        return "keychain"
    if shutil.which("secret-tool") and os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return "secret-tool"
    return "file"


def pass_entry(name: str) -> str:
    prefix = (os.environ.get("WOUF_PASS_PREFIX") or SERVICE).strip("/")
    return f"{prefix}/{name}"


# Names are indexed in the store directory for every backend, so "list" works everywhere.
def index_path() -> Path:
    return store_dir() / ".names"


def names() -> list[str]:
    path = index_path()
    return sorted(set(path.read_text().split())) if path.exists() else []


def write_index(items: list[str]) -> None:
    path = index_path()
    path.write_text("".join(f"{n}\n" for n in sorted(set(items))))
    os.chmod(path, 0o600)


def pass_file(entry: str) -> Path:
    base = os.environ.get("PASSWORD_STORE_DIR") or os.path.expanduser("~/.password-store")
    return Path(base).expanduser() / f"{entry}.gpg"


def stop_group(proc: subprocess.Popen) -> None:
    # gpg may have started its own children; the whole group goes, so nothing is left waiting for a prompt.
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (AttributeError, OSError):
        proc.kill()
    proc.wait()


def read_pass(name: str) -> str | None:
    if PASS_BROKEN:
        raise StoreLocked(PASS_LOCKED)
    entry = pass_entry(name)
    # gpg is told to fail rather than start pinentry, reads nothing from the terminal, and the wait is bounded: a
    # locked store then ends in one line instead of a prompt that nobody sees.
    gpg_opts = " ".join(filter(None, [os.environ.get("PASSWORD_STORE_GPG_OPTS", ""), "--pinentry-mode error"]))
    env = {**os.environ, "PASSWORD_STORE_GPG_OPTS": gpg_opts}
    with tempfile.TemporaryFile() as out:
        proc = subprocess.Popen(["pass", "show", entry], stdin=subprocess.DEVNULL, stdout=out,
                                stderr=subprocess.DEVNULL, env=env, start_new_session=True)
        try:
            code: int | None = proc.wait(timeout=PASS_TIMEOUT)
        except subprocess.TimeoutExpired:
            stop_group(proc)
            code = None
        if code == 0:
            out.seek(0)
            lines = out.read().decode("utf-8").splitlines()
            return (lines[0] if lines else "") or None
    # pass exits non-zero for an entry that is not there; an entry that is there but was not read is a locked store.
    if code is None or pass_file(entry).exists():
        PASS_BROKEN.append(name)
        raise StoreLocked(PASS_LOCKED)
    return None


def read_value(name: str) -> str | None:
    kind = backend()
    if kind == "file":
        path = store_dir() / name
        return (path.read_text().rstrip("\n") or None) if path.exists() else None
    if kind == "pass":
        return read_pass(name)
    if kind == "keychain":
        cmd = ["security", "find-generic-password", "-s", SERVICE, "-a", name, "-w"]
    else:
        cmd = ["secret-tool", "lookup", "service", SERVICE, "account", name]
    result = subprocess.run(cmd, capture_output=True, text=True)
    return (result.stdout.rstrip("\n") or None) if result.returncode == 0 else None


def cmd_set(name: str) -> None:
    require_terminal("set")
    kind = backend()
    if kind == "keychain":
        # security prompts for the value itself, so it never appears in a process list.
        result = subprocess.run(["security", "add-generic-password", "-U", "-s", SERVICE, "-a", name, "-w"])
        if result.returncode:
            die("keychain refused the value", result.returncode)
    else:
        value = getpass.getpass(f"Value for {name} (hidden): ")
        if not value:
            die("empty value, nothing stored")
        if kind == "file":
            path = store_dir() / name
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as handle:
                handle.write(value + "\n")
            os.chmod(path, 0o600)
        elif kind == "pass":
            # The value goes in on standard input, never as an argument.
            result = subprocess.run(["pass", "insert", "-m", "-f", pass_entry(name)], input=value + "\n",
                                    text=True, capture_output=True)
            if result.returncode:
                die("pass refused the value", result.returncode)
        else:
            result = subprocess.run(["secret-tool", "store", f"--label={SERVICE}:{name}", "service", SERVICE,
                                     "account", name], input=value, text=True)
            if result.returncode:
                die("secret-tool refused the value", result.returncode)
    write_index(names() + [name])
    print(f"stored {name} ({kind})", file=sys.stderr)


def cmd_rm(name: str) -> None:
    require_terminal("rm")
    kind = backend()
    if kind == "file":
        (store_dir() / name).unlink(missing_ok=True)
    elif kind == "keychain":
        subprocess.run(["security", "delete-generic-password", "-s", SERVICE, "-a", name], capture_output=True)
    elif kind == "pass":
        subprocess.run(["pass", "rm", "-f", pass_entry(name)], capture_output=True)
    else:
        subprocess.run(["secret-tool", "clear", "service", SERVICE, "account", name], capture_output=True)
    write_index([n for n in names() if n != name])
    print(f"removed {name}", file=sys.stderr)


def cmd_run(spec: str, command: list[str]) -> int:
    if not command:
        die("usage: secret run NAME[,NAME] -- command [args]")
    env = dict(os.environ)
    values = []
    for name in (check_name(n) for n in spec.split(",")):
        value = read_value(name)
        if value is None:
            die(f"{name} is not stored. Ask the person to run in their own terminal: secret set {name}")
        env[name] = value
        values.append(value)
    values.sort(key=len, reverse=True)
    proc = subprocess.Popen(command, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    assert proc.stdout is not None
    out = sys.stdout.buffer
    for line in proc.stdout:
        for value in values:
            line = line.replace(value.encode(), MASK.encode())
        out.write(line)
        out.flush()
    return proc.wait()


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    action, rest = argv[0], argv[1:]
    if action == "list" and not rest:
        print("\n".join(names()))
        return 0
    if action == "run":
        if "--" not in rest or rest.index("--") != 1:
            die("usage: secret run NAME[,NAME] -- command [args]")
        return cmd_run(rest[0], rest[2:])
    if action in ("set", "has", "rm") and len(rest) == 1:
        name = check_name(rest[0])
        if action == "set":
            cmd_set(name)
        elif action == "rm":
            cmd_rm(name)
        else:
            return 0 if read_value(name) is not None else 1
        return 0
    die(f"unknown command: {' '.join(argv)} (see: secret help)")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except StoreLocked as error:
        die(str(error))
